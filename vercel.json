{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/site-builder",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/site-builder/:path*",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/admin-site-builder"
    },
    {
      "source": "/admin/",
      "destination": "/api/admin-site-builder"
    },
    {
      "source": "/admin/crm",
      "destination": "/api/admin-site-builder?view=crm"
    },
    {
      "source": "/admin/crm/",
      "destination": "/api/admin-site-builder?view=crm"
    },
    {
      "source": "/admin/place-insights/api",
      "destination": "/api/admin-place-keyword-insights"
    },
    {
      "source": "/admin/place-insights",
      "destination": "/api/admin-site-builder?view=insights"
    },
    {
      "source": "/admin/place-insights/",
      "destination": "/api/admin-site-builder?view=insights"
    },
    {
      "source": "/admin/competitors/api",
      "destination": "/api/admin-competitor-compare"
    },
    {
      "source": "/admin/competitors",
      "destination": "/api/admin-site-builder?view=competitors"
    },
    {
      "source": "/admin/competitors/",
      "destination": "/api/admin-site-builder?view=competitors"
    },
    {
      "source": "/admin/keyword-matrix/api",
      "destination": "/api/admin-keyword-matrix"
    },
    {
      "source": "/admin/keyword-matrix",
      "destination": "/api/admin-site-builder?view=keywords"
    },
    {
      "source": "/admin/keyword-matrix/",
      "destination": "/api/admin-site-builder?view=keywords"
    },
    {
      "source": "/admin/watches/api",
      "destination": "/api/admin-rank-watches"
    },
    {
      "source": "/admin/watches",
      "destination": "/api/admin-site-builder?view=watches"
    },
    {
      "source": "/admin/watches/",
      "destination": "/api/admin-site-builder?view=watches"
    },
    {
      "source": "/admin/designs",
      "destination": "/api/admin-site-builder?view=designs"
    },
    {
      "source": "/admin/designs/",
      "destination": "/api/admin-site-builder?view=designs"
    },
    {
      "source": "/admin/login",
      "destination": "/api/admin-site-builder?action=login"
    },
    {
      "source": "/admin/logout",
      "destination": "/api/admin-site-builder?action=logout"
    },
    {
      "source": "/admin/assets/:asset",
      "destination": "/api/admin-site-builder?asset=:asset"
    }
  ],
  "functions": {
    "api/admin-site-builder.js": {
      "includeFiles": "site-builder/**"
    },
    "api/place-rank-live.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/rank-watch-cron.js": {
      "maxDuration": 60
    },
    "api/admin-keyword-matrix.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/admin-competitor-compare.js": {
      "maxDuration": 30
    },
    "api/admin-place-keyword-insights.js": {
      "maxDuration": 30
    }
  }
}
